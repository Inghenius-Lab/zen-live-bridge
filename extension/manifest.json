{
  "manifest_version": 3,
  "name": "Zen Live Bridge",
  "version": "0.7.0",
  "description": "Puente local (WebSocket 127.0.0.1:8788) para controlar Zen abierto desde agentes. Todo local, nada sale de la maquina.",
  "browser_specific_settings": {
    "gecko": {
      "id": "zen-live-bridge@elemental.local"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "tabs",
    "cookies",
    "contextualIdentities",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:8788"
  }
}