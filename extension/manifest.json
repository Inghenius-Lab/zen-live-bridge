{
  "manifest_version": 3,
  "name": "Zen Live Bridge",
  "version": "0.9.0",
  "description": "Puente local para controlar Zen abierto desde agentes, con panel lateral. Todo en 127.0.0.1, nada sale de la maquina.",
  "browser_specific_settings": {
    "gecko": {
      "id": "zen-live-bridge@elemental.local"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "sidebar_action": {
    "default_title": "Zen Live",
    "default_panel": "panel.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "tabs",
    "cookies",
    "contextualIdentities",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:8788 http://127.0.0.1:8789"
  }
}
