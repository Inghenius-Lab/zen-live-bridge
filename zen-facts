#!/usr/bin/env python3
"""ZEN-FACTS: la verdad sobre Zen Live, leida del codigo y del sistema.

Por que existe: los agentes se confunden cuando la documentacion dice una cosa
y el codigo otra. Este script NO lee documentacion. Lee el codigo real y el
estado real del sistema. Si algo no existe, no lo imprime.

Uso:
  zen-facts            -> informe completo (markdown)
  zen-facts --json     -> lo mismo, en JSON
  zen-facts --check    -> solo deriva entre help/documentacion y codigo (exit 1 si hay deriva)
"""
import json, os, re, subprocess, sys

REPO = os.path.expanduser("~/Personal/Documentos/Proyectos/zen-live-bridge")
HUB  = os.path.expanduser("~/.local/share/skills-hub/zen-live-bridge")
CLI  = os.path.join(REPO, "zen-live")
BRIDGE = os.path.join(REPO, "zen-live-bridge.py")
EXT  = os.path.join(REPO, "extension", "background.js")
MANIFEST = os.path.join(REPO, "extension", "manifest.json")

def leer(p, default=""):
    try:
        return open(p, encoding="utf-8", errors="replace").read()
    except OSError:
        return default

def sh(cmd):
    try:
        return subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=15).stdout.strip()
    except Exception:
        return ""

# ---- comandos: del dispatcher real, no del help -----------------------------
def comandos_real():
    """Extrae los cmd que el dispatcher implementa de verdad."""
    src, out = leer(CLI), set()
    # if cmd == "nombre"   /  if cmd in ("a","b")
    for m in re.finditer(r'if\s+cmd\s*==\s*"([a-zA-Z][\w-]*)"', src):
        out.add(m.group(1))
    for m in re.finditer(r'if\s+cmd\s+in\s+[\(\{]?([^\)\}\n]+)', src):
        for s in re.findall(r'"([a-zA-Z][\w-]*)"', m.group(1)):
            out.add(s)
    return sorted(out)

# ---- comandos: los que el help promete --------------------------------------
def comandos_help():
    """Lo que el docstring del CLI promete. Aqui es donde suele haber deriva."""
    src = leer(CLI)
    d = re.search(r'"""(.*?)"""', src, re.S)
    if not d:
        return []
    out = set()
    for ln in d.group(1).splitlines():
        # comando = linea que empieza con un token y NO contiene mayusculas
        # (las frases de prosa del docstring tienen mayusculas)
        m = re.match(r'^\s+([a-z][a-z0-9-]{2,})\s{2,}', ln)
        if m and not re.search(r'[A-Z]', ln.split()[0]):
            out.add(m.group(1))
    return sorted(out)

# ---- guards -----------------------------------------------------------------
def guards():
    """Los 6 guards, leidos de donde vive cada uno.

    No todos se nombran igual: los de la extension (url-scheme, password-field)
    viajan como "guard" en el JSON de error; los del puente (read-only,
    rate-limit, protected-site) igual; el audit log se llama distinto. Se
    buscan todos los patrones y secomparan con la lista de referencia, que se
    verifica contra el codigo con un grep, no contra un README.
    """
    ext = leer(EXT)
    brg = leer(BRIDGE)
    g = set()
    # extension y puente: clave "guard": "nombre" en el JSON de error
    for src in (ext, brg):
        g |= set(re.findall(r'["\']guard["\']\s*:\s*"([a-z][\w-]*)"', src))
        g |= set(re.findall(r'guard\s*=\s*"([a-z][\w-]*)"', src))
        g |= set(re.findall(r'guard\s*:\s*"([a-z][\w-]*)"', src))
    # el audit log: se detecta por su fichero de destino
    if "audit.jsonl" in brg:
        g.add("audit")
    return sorted(x for x in g if x and not x.startswith("ok"))

# ---- puertos: estado real, no documentado ------------------------------------
PUERTOS = [
    (2828, "Marionette (firefox-devtools MCP: alert/confirm, upload, extensiones)"),
    (8788, "WebSocket de la extension"),
    (8789, "servidor web del panel local"),
    (8790, "TCP del CLI"),
]

def puertos():
    out = sh("ss -tln 2>/dev/null")
    r = []
    for p, desc in PUERTOS:
        line = next((l for l in out.splitlines() if re.search(r':%d\s' % p, l)), "")
        addr = line.split()[3] if len(line.split()) > 3 else ""
        r.append({
            "puerto": p, "escuchando": bool(line), "addr": addr or "-",
            "loopback_only": addr.startswith("127.0.0.1") if addr else None,
            "que_es": desc,
        })
    return r

def backend_marionette():
    """Marionette vive solo si Zen se lanzo con --marionette."""
    return any(p["puerto"] == 2828 and p["escuchando"] for p in puertos())

def manifiesto():
    m = leer(MANIFEST, "{}")
    ver = re.search(r'"version"\s*:\s*"([^"]+)"', m)
    perms = sorted(set(re.findall(r'"(activeTab|tabs|scripting|storage|history|cookies|downloads|webNavigation|alarms|sidePanel)"', m)))
    return {"version": ver.group(1) if ver else "?", "permisos": perms}

def interfaz():
    """El puente tiene su propia API; no confundir con los comandos."""
    src = leer(BRIDGE)
    return sorted(set(re.findall(r'["\'](/api/[a-z_-]+)', src)))

def main():
    d = {
        "version": manifiesto()["version"],
        "permisos": manifiesto()["permisos"],
        "comandos_implementados": comandos_real(),
        "comandos_prometidos_por_help": comandos_help(),
        "guards": guards(),
        "puertos": puertos(),
        "marionette_activo": backend_marionette(),
        "endpoints_bridge": interfaz(),
        "repo": REPO,
    }
    deriva = sorted(set(d["comandos_prometidos_por_help"]) - set(d["comandos_implementados"]))

    if "--json" in sys.argv:
        d["deriva_help_vs_codigo"] = deriva
        print(json.dumps(d, indent=2, ensure_ascii=False)); return 0

    if "--check" in sys.argv:
        if deriva:
            print("DERIVA: el help promete %d comando(s) que el codigo no implementa:" % len(deriva))
            for c in deriva: print("   -", c)
            return 1
        print("OK: el help y el codigo coinciden (%d comandos)" % len(d["comandos_implementados"]))
        return 0

    L = []
    L.append("# ZEN-FACTS  (generado del codigo y del sistema, no de la documentacion)\n")
    L.append("version declarada: **%s**" % d["version"])
    L.append("permisos de la extension: %s\n" % ", ".join(d["permisos"]))
    L.append("## Backends")
    L.append("- WebExtension: puertos 8788/8789/8790, requiere token")
    L.append("- Marionette: puerto 2828 -> %s" % ("ACTIVO" if d["marionette_activo"] else "INACTIVO (falta --marionette al lanzar Zen)"))
    if not d["marionette_activo"]:
        L.append("  - Sin Marionette NO hay alert/confirm, ni subir ficheros, ni instalar extensiones.")
    L.append("")
    L.append("## Puertos (estado real)")
    for p in d["puertos"]:
        L.append("- %s %d  %s  %s" % ("OK " if p["escuchando"] else "DOWN", p["puerto"], p["addr"], p["que_es"]))
    L.append("")
    L.append("## Comandos que el codigo implementa (%d)" % len(d["comandos_implementados"]))
    L.append("```\n%s\n```\n" % " ".join(d["comandos_implementados"]))
    L.append("## Guards de seguridad (%d)" % len(d["guards"]))
    L.append("```\n%s\n```\n" % " ".join(d["guards"]))
    L.append("## Endpoints del puente (no son comandos del CLI)")
    L.append("```\n%s\n```" % " ".join(d["endpoints_bridge"]))
    if deriva:
        L.append("## DERIVA DETECTADA")
        L.append("el help promete comandos que el codigo no tiene: %s" % " ".join(deriva))
    print("\n".join(L))
    return 0

if __name__ == "__main__":
    sys.exit(main())
