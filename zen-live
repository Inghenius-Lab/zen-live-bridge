#!/usr/bin/env python3
"""zen-live — CLI para controlar la instancia de Zen ABIERTA via WebExtension.

Uso:
  zen-live serve                      arranca el puente local (TCP 8790 + WS 8788)
  zen-live status                     comprueba puente + extension
  zen-live stop                       apaga el puente
  zen-live tabs                       lista pestanyas del Zen abierto
  zen-live goto URL [--new|--same]    abre pestanya (sin robar foco) o navega la activa
  zen-live activate [TABID]           marca activa (y trae la ventana al frente si hace falta)
  zen-live text [--limit N]           texto visible de la pestanya activa
  zen-live snap                       texto + interactivos con selectores css
  zen-live click --sel CSS | --text TEXTO [--wait MS]
  zen-live fill --sel CSS --value V [--submit] [--wait MS]
  zen-live js 'EXPRESION'             evalua JS en la pestanya activa
  zen-live shot NOMBRE                captura PNG a /tmp/zen-shot/NOMBRE.png
  zen-live cookies [URL]              cookies de un sitio (por defecto el activo)
  zen-live scroll [PX] [--dir up|down] [--sel CSS] [--wait MS]
                                     scrollea la pestanya activa y reporta el delta
  zen-live close TABID                cierra una pestanya (las del agente, no las tuyas)

Requiere: la extension "Zen Live Bridge" cargada en Zen (about:debugging o
instalada). Sin extension, ping falla con mensaje claro.
  guards                            # estado de los safety guards (v0.11)
  readonly on|off                   # modo lectura: bloquea escrituras (v0.11)
  ratelimit N                       # max escrituras/min, 0 = sin limite (v0.11)
  audit [--limit N]                 # ultimas decisiones (permitido/denegado) (v0.11)
  localstorage <list|get|set|delete|clear> [clave] [valor]
  sessionstorage <list|get|set|delete|clear> [clave] [valor]
  storage-clear                        limpia localStorage y sessionStorage
  network [filtro] [--limit N]         peticiones de red de la pagina
  css <selector>                       estilos computados de un elemento
  resize --width N --height N          redimensiona la ventana
"""
import base64, json, os, socket, subprocess, sys, time
from sys import argv

TOKEN_FILE = os.path.expanduser(
    os.environ.get("ZEN_LIVE_TOKEN_FILE", "~/.local/state/zen-live-bridge/token"))


def load_token():
    """Token del puente. Se lee en cada envio, asi que rotar el archivo basta
    y no hay que reinstalar el CLI."""
    try:
        with open(TOKEN_FILE) as f:
            return f.read().strip()
    except OSError:
        return ""


HTTP_PORT = int(os.environ.get("ZEN_LIVE_HTTP", "8789"))
TCP_PORT = int(os.environ.get("ZEN_LIVE_TCP", "8790"))  # 8787 = stt-server (canonico ecosistema)
WS_PORT = int(os.environ.get("ZEN_LIVE_WS", "8788"))
BRIDGE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "zen-live-bridge.py")


def send(cmd, timeout=120):
    # Guard 5: si el agente repite el comando con el confirm_token que le dio el
    # puente, se lo pasamos. Se anade aqui y no en cada rama para que funcione
    # con los 48 comandos sin tocar cada uno.
    if "--confirm-token" in sys.argv:
        cmd = dict(cmd, confirm_token=sys.argv[sys.argv.index("--confirm-token") + 1])
    try:
        s = socket.create_connection(("127.0.0.1", TCP_PORT), timeout=5)
    except OSError as e:
        return {"ok": False, "error": f"puente caido: {e}. Arranca con 'zen-live serve'"}
    try:
        s.sendall((json.dumps(dict(cmd, token=load_token())) + "\n").encode())
        s.settimeout(timeout + 10)
        buf = b""
        while b"\n" not in buf:
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
    except Exception as e:
        return {"ok": False, "error": f"tcp: {e}"}
    finally:
        s.close()
    try:
        return json.loads(buf.split(b"\n", 1)[0].decode())
    except Exception:
        return {"ok": False, "error": f"respuesta invalida: {buf[:200]!r}"}


def _http_control(payload):
    """Cambia el estado de los guards por la API HTTP del puente.

    El flag de read-only lo tiene que cambiar ALGUIEN con el token, y el CLI de
    TCP solo puede mandar ordenes a la extension: si `readonly off` fuera un
    comando mas de los 48, el propio guard lo dejaria bloqueado para siempre.
    """
    try:
        import http.client
        conn = http.client.HTTPConnection("127.0.0.1", HTTP_PORT, timeout=8)
        body = json.dumps(payload)
        conn.request("POST", "/api/guards", body,
                     {"Content-Type": "application/json", "x-zen-live-token": load_token()})
        r = conn.getresponse()
        return json.loads(r.read().decode())
    except Exception as e:
        return {"ok": False, "error": "control HTTP: %s" % e}

def ensure_server():
    if server_up():
        return True
    log = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "server.log")
    log = os.path.abspath(log)
    with open(log, "a") as f:
        subprocess.Popen([sys.executable, BRIDGE], stdout=f, stderr=subprocess.STDOUT,
                         start_new_session=True)
    for _ in range(30):
        if server_up():
            return True
        time.sleep(0.2)
    return False


def server_up():
    try:
        s = socket.create_connection(("127.0.0.1", TCP_PORT), timeout=0.5)
        s.close()
        return True
    except OSError:
        return False


def status():
    up = server_up()
    if not up:
        print("puente:  DOWN  (arranca con 'zen-live serve')")
        return
    ping = send({"cmd": "ping"}, timeout=10)
    if ping.get("pong"):
        print(f"puente:  UP  (tcp {TCP_PORT} / ws {WS_PORT})")
        print(f"extension: OK  {ping.get('name')} v{ping.get('version')}")
    else:
        print(f"puente:  UP  (tcp {TCP_PORT} / ws {WS_PORT})")
        print(f"extension: DESCONECTADA — carga 'Zen Live Bridge' en about:debugging "
              f"o instalala en about:addons ({ping.get('error','')})")


def opt(flag, default=""):
    """Valor de un flag estilo --flag val, o default si no esta."""
    a = sys.argv
    if flag in a and a.index(flag) + 1 < len(a):
        return a[a.index(flag) + 1]
    return default


def main():
    args = sys.argv[1:]
    if not args:
        print(__doc__)
        return
    cmd = args.pop(0)

    if cmd == "serve":
        if server_up():
            print("puente ya activo"); return
        log = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "server.log")
        with open(os.path.abspath(log), "a") as f:
            subprocess.Popen([sys.executable, BRIDGE], stdout=f, stderr=subprocess.STDOUT,
                             start_new_session=True)
        for _ in range(30):
            if server_up():
                print(f"puente activo (tcp {TCP_PORT} / ws {WS_PORT}). Extension lista? -> zen-live status")
                return
            time.sleep(0.2)
        print("ERROR: el puente no arranco. Mira el log")
        return

    if cmd == "stop":
        try:
            send({"cmd": "shutdown"}, timeout=5)
            print("puente apagado")
        except Exception as e:
            print(f"no se pudo apagar: {e}")
        return

    if cmd == "status":
        status()
        return

    if not ensure_server():
        print("ERROR: no hay puente. Arranca con 'zen-live serve'")
        sys.exit(1)

    if cmd == "tabs":
        r = send({"cmd": "tabs"})
        for t in r.get("tabs", []):
            mark = "*" if t["active"] else " "
            print(f"{mark} {t['id']:>4}  {t['title'][:50] or '(sin titulo)'}  {t['url'][:80]}")
        return

    if cmd == "goto":
        url = args[0] if args else input("URL: ")
        mode = "new" if "--new" in sys.argv or "-n" in sys.argv else ("same" if "--same" in sys.argv else "new")
        wait = None
        if "--wait" in sys.argv:
            wait = int(sys.argv[sys.argv.index("--wait") + 1])
        payload = {"cmd": "goto", "url": url, "new": mode == "new", "wait": wait}
        if "--container" in sys.argv:
            payload["container"] = sys.argv[sys.argv.index("--container") + 1]
        if "--cookie-store" in sys.argv:
            payload["cookieStoreId"] = sys.argv[sys.argv.index("--cookie-store") + 1]
        r = send(payload)
        print(json.dumps(r, ensure_ascii=False))
        return

    if cmd == "activate":
        tab_id = args[0] if args else None
        r = send({"cmd": "activate", "tabId": (int(tab_id) if tab_id else None)})
        print(json.dumps(r, ensure_ascii=False))
        return

    if cmd == "text":
        limit = 60000
        if "--limit" in sys.argv:
            limit = int(sys.argv[sys.argv.index("--limit") + 1])
        r = send({"cmd": "text", "limit": limit, "tabId": int(opt("--tab", "0")) or None})
        if r.get("ok"):
            print(r.get("text", ""))
        else:
            print(json.dumps(r, ensure_ascii=False))
        return

    if cmd == "snap":
        r = send({"cmd": "snap"})
        if not r.get("ok"):
            print(json.dumps(r, ensure_ascii=False)); return
        print(f"== {r.get('title','')} — {r.get('url','')}")
        for e in r.get("els", []):
            print(f"[{e.get('i','?')}] <{e.get('tag','?')}> {e.get('text','')[:70] or '(sin texto)'}  css={e.get('css','(n/a)')}")
        print("---- texto ----")
        print(r.get("text", "")[:8000])
        return

    if cmd == "click":
        sel = None; text = None; wait = None
        if "--sel" in sys.argv: sel = sys.argv[sys.argv.index("--sel") + 1]
        if "--text" in sys.argv: text = sys.argv[sys.argv.index("--text") + 1]
        if "--wait" in sys.argv: wait = int(sys.argv[sys.argv.index("--wait") + 1])
        if not sel and not text:
            print("necesitas --sel CSS o --text TEXTO"); sys.exit(1)
        r = send({"cmd": "click", "sel": sel, "text": text, "wait": wait,
                  "tabId": int(opt("--tab", "0")) or None})
        print(json.dumps(r, ensure_ascii=False))
        return

    if cmd == "fill":
        if "--sel" not in sys.argv:
            print("necesitas --sel CSS y --value"); sys.exit(1)
        sel = sys.argv[sys.argv.index("--sel") + 1]
        value = sys.argv[sys.argv.index("--value") + 1] if "--value" in sys.argv else ""
        submit = "--submit" in sys.argv
        wait = int(sys.argv[sys.argv.index("--wait") + 1]) if "--wait" in sys.argv else None
        nth = int(sys.argv[sys.argv.index("--nth") + 1]) if "--nth" in sys.argv else None
        r = send({"cmd": "fill", "sel": sel, "value": value, "submit": submit, "wait": wait, "nth": nth,
                  "tabId": int(opt("--tab", "0")) or None})
        print(json.dumps(r, ensure_ascii=False))
        return

    if cmd == "shadowfill":
        if "--sel" not in sys.argv:
            print("necesitas --sel 'host>>>nivel>>>campo' y --value"); sys.exit(1)
        sel = sys.argv[sys.argv.index("--sel") + 1]
        value = sys.argv[sys.argv.index("--value") + 1] if "--value" in sys.argv else ""
        submit = "--submit" in sys.argv
        wait = int(sys.argv[sys.argv.index("--wait") + 1]) if "--wait" in sys.argv else None
        r = send({"cmd": "shadowfill", "sel": sel, "value": value, "submit": submit, "wait": wait})
        print(json.dumps(r, ensure_ascii=False))
        return

    if cmd == "js":
        expr = " ".join(a for a in args if not a.startswith("--"))
        payload = {"cmd": "js", "expr": expr}
        if "--allow-eval" in sys.argv:
            payload["allowEval"] = True
        r = send(payload)
        if r.get("ok"):
            val = r.get("value")
            print(val if isinstance(val, str) else json.dumps(val, ensure_ascii=False))
        else:
            print(json.dumps(r, ensure_ascii=False))
        return

    if cmd == "list-containers":
        r = send({"cmd": "listContainers"})
        print(json.dumps(r, ensure_ascii=False, indent=2))
        return

    if cmd == "cookies-for":
        url = args[0] if args else input("URL: ")
        payload = {"cmd": "cookiesFor", "url": url}
        if "--cookie-store" in sys.argv:
            payload["cookieStoreId"] = sys.argv[sys.argv.index("--cookie-store") + 1]
        r = send(payload)
        print(json.dumps(r, ensure_ascii=False, indent=2))
        return

    if cmd == "key":
        r = send({"cmd": "key", "key": sys.argv[2] if len(sys.argv) > 2 and not sys.argv[2].startswith("-") else "Enter",
                  "sel": opt("--sel", ""), "tabId": int(opt("--tab", "0")) or None})
        print(json.dumps(r, ensure_ascii=False, indent=2))
        return

    if cmd == "hover":
        r = send({"cmd": "hover", "sel": opt("--sel", ""),
                  "nth": int(opt("--nth", "")) if opt("--nth", "") else None,
                  "tabId": int(opt("--tab", "0")) or None})
        print(json.dumps(r, ensure_ascii=False, indent=2))
        return

    if cmd == "links":
        r = send({"cmd": "links", "filter": opt("--filter", ""),
                  "tabId": int(opt("--tab", "0")) or None})
        lim = int(opt("--limit", "40"))
        if r.get("ok"):
            print(f"{r.get('count', 0)} links (mostrando {min(lim, r.get('count', 0))})")
            for l in r.get("links", [])[:lim]:
                print(f"  {l.get('text','')[:70]} -> {l.get('href','')}")
            if r.get("count", 0) > lim:
                print(f"  ... {r.get('count', 0) - lim} mas (--limit / --filter)")
        else:
            print(json.dumps(r, ensure_ascii=False))
        return

    if cmd == "select":
        vals = opt("--values", "")
        r = send({"cmd": "select", "sel": opt("--sel", ""),
                  "values": [v for v in vals.split(",") if v],
                  "tabId": int(opt("--tab", "0")) or None})
        print(json.dumps(r, ensure_ascii=False, indent=2))
        return

    if cmd == "wait":
        # La espera vive en el cliente: el service worker de la extension se
        # duerme solo, asi que un setTimeout ahi no es fiable. El sondeo usa
        # el comando exists y no js, porque js exige --allow-eval y falla
        # bajo CSP (X, Gmail y varias SPA).
        sel, txt = opt("--sel", ""), opt("--text", "")
        timeout = int(opt("--timeout", "15000"))
        paso = int(opt("--step", "400"))
        tabid = int(opt("--tab", "0")) or None
        if not sel and not txt:
            print(json.dumps({"ok": False, "error": "usa --sel o --text"}, ensure_ascii=False))
            return
        limite = time.time() + timeout / 1000.0
        while True:
            probe = send({"cmd": "exists", "sel": sel, "text": txt, "tabId": tabid})
            if probe.get("found"):
                print(json.dumps({"ok": True, "found": True, "tag": probe.get("tag"),
                                  "esperado": sel or txt}, ensure_ascii=False))
                return
            if time.time() >= limite:
                print(json.dumps({"ok": False, "error": "timeout %dms esperando %s"
                                  % (timeout, sel or txt)}, ensure_ascii=False))
                return
            time.sleep(paso / 1000.0)

    if cmd in ("back", "forward", "reload", "interactive", "annotate-clear"):
        r = send({"cmd": cmd, "tabId": int(opt("--tab", "0")) or None})
        if not r.get("ok"):
            print(json.dumps(r, ensure_ascii=False)); return
        if cmd == "interactive":
            print("%d elementos interactivos" % r.get("count", 0))
            for it in r.get("elements", [])[:25]:
                print("  %2d %-8s %s" % (it.get("n"), it.get("tag"), it.get("text", "")[:52]))
        elif cmd == "annotate-clear":
            print("anotaciones quitadas")
        else:
            print("%s ok (tab %s)" % (cmd, r.get("tabId")))
        return

    if cmd == "locate":
        r = send({"cmd": "locate", "sel": opt("--sel", ""), "text": opt("--text", ""),
                  "nth": int(opt("--nth", "")) if opt("--nth", "") else None,
                  "tabId": int(opt("--tab", "0")) or None})
        if r.get("ok"):
            print("x={x} y={y} {tag} {w}x{h} inViewport={v}".format(
                x=r.get("x"), y=r.get("y"), tag=r.get("tag"),
                w=r.get("w"), h=r.get("h"), v=r.get("inViewport")))
            print("  texto: %s" % (r.get("text", "")[:70]))
            if not r.get("inViewport"):
                print("  aviso: fuera del viewport, scrollea antes de clicar por coordenadas")
        else:
            print(json.dumps(r, ensure_ascii=False))
        return

    if cmd == "annotate":
        r = send({"cmd": "annotate", "clear": "clear" in sys.argv,
                  "tabId": int(opt("--tab", "0")) or None})
        if r.get("ok") and not r.get("cleared"):
            print("%d elementos interactuables numerados (pointer-events:none)" % r.get("count", 0))
            for it in r.get("items", [])[:25]:
                print("  %2d %-8s %s" % (it.get("n"), it.get("tag"), it.get("text", "")[:52]))
            if r.get("count", 0) > 25:
                print("  ... %d mas" % (r.get("count", 0) - 25))
            print("luego: zen-live click-at N   (o 'zen-live annotate clear' para quitarlo)")
        else:
            print(json.dumps(r, ensure_ascii=False))
        return

    if cmd == "click-at":
        r = send({"cmd": "click-at", "n": argv[2] if len(argv) > 2 else "0",
                  "tabId": int(opt("--tab", "0")) or None})
        print(json.dumps(r, ensure_ascii=False, indent=2))
        return

    if cmd == "console":
        r = send({"cmd": "console", "clear": "--clear" in sys.argv,
                  "tabId": int(opt("--tab", "0")) or None})
        if r.get("ok"):
            print("%d entradas de console" % r.get("count", 0))
            for e in r.get("entries", []):
                print("  [%-5s] %s" % (e.get("type"), e.get("text", "")[:110]))
        else:
            print(json.dumps(r, ensure_ascii=False))
        return

    # --- v0.10: almacenamiento, red, css, ventana ---
    if cmd == "history":
        # El filtro son los args que NO son flags ni su valor. Sin esto,
        # "history --limit 5" mandaba "--limit" como texto a buscar y
        # history.search devolvia 0 resultados.
        flags = {"--limit", "--tab"}
        pos = []
        i = 0
        while i < len(args):
            if args[i] in flags:
                i += 2; continue
            pos.append(args[i]); i += 1
        r = send({"cmd": "history",
                  "filter": " ".join(pos),
                  "limit": int(opt("--limit", "20")),
                  "tabId": int(opt("--tab", "0")) or None})
        if not r.get("ok"):
            print(r.get("error", "error")); return
        print("%d entradas de historial" % r.get("count", 0))
        for it in r.get("items", []):
            when = (it.get("lastVisit") or "")[:16].replace("T", " ")
            print("  %s  %s" % (when, it.get("title") or "(sin titulo)"))
            print("      %s" % it.get("url", ""))
        return

    if cmd in ("localstorage", "sessionstorage"):
        action = args[0] if args else "list"
        r = send({"cmd": cmd, "action": action,
                  "key": args[1] if len(args) > 1 else "",
                  "value": args[2] if len(args) > 2 else "",
                  "tabId": int(opt("--tab", "0")) or None})
        if not r.get("ok"):
            print(json.dumps(r, ensure_ascii=False)); return
        if action == "list":
            keys = r.get("keys", [])
            print("%d claves en %s" % (len(keys), cmd))
            for k in keys[:40]:
                print("  %s" % k)
            if len(keys) > 40:
                print("  ... %d mas" % (len(keys) - 40))
            print("  (solo claves; los valores se leen de uno en uno: '%s get <clave>')" % cmd)
        elif action in ("get", "set", "delete", "clear"):
            print("%s %s ok" % (cmd, action))
        else:
            print(json.dumps(r, ensure_ascii=False))
        return

    if cmd == "storage-clear":
        r = send({"cmd": "storage-clear", "tabId": int(opt("--tab", "0")) or None})
        print(json.dumps(r, ensure_ascii=False) if not r.get("ok")
              else "localStorage y sessionStorage limpiados")
        return

    if cmd == "network":
        r = send({"cmd": "network", "filter": args[0] if args else "",
                  "limit": int(opt("--limit", "50")),
                  "tabId": int(opt("--tab", "0")) or None})
        if not r.get("ok"):
            print(json.dumps(r, ensure_ascii=False)); return
        items = r.get("items", [])
        print("%d peticiones%s" % (len(items), (" de " + r["filter"]) if r.get("filter") else ""))
        for it in items[:60]:
            print("  %-6s %-9s %8s  %s" % (it.get("status", "-"), it.get("kind", "?"),
                                            it.get("size", "-"), (it.get("url") or "")[:94]))
        if r.get("redacted"):
            print("  (%d query strings con tokens ocultos)" % r["redacted"])
        return

    if cmd == "css":
        r = send({"cmd": "css", "sel": opt("--sel", "") or (args[0] if args else ""),
                  "text": opt("--text", ""),
                  "tabId": int(opt("--tab", "0")) or None})
        if not r.get("ok"):
            print(json.dumps(r, ensure_ascii=False)); return
        print("estilos de %s" % (r.get("selector") or "?"))
        for k, v in (r.get("styles") or {}).items():
            print("  %-14s %s" % (k, v))
        return

    if cmd == "resize":
        w, h = opt("--width", "0"), opt("--height", "0")
        r = send({"cmd": "resize", "width": int(w) if w else None, "height": int(h) if h else None,
                  "tabId": int(opt("--tab", "0")) or None})
        print(json.dumps(r, ensure_ascii=False, indent=2) if not r.get("ok")
              else "ventana ahora %sx%s" % (r.get("width"), r.get("height")))
        return

    if cmd == "set-range":
        r = send({"cmd": "set-range", "sel": opt("--sel", ""),
                  "value": float(opt("--value", "0")) if opt("--value", "") else 0,
                  "tabId": int(opt("--tab", "0")) or None})
        print(json.dumps(r, ensure_ascii=False, indent=2))
        if r.get("ok") and not r.get("trusted"):
            print("AVISO: la pagina reescribio el valor (pedido %s, real %s). "
                  "El control ignoro el set." % (r.get("requested"), r.get("observed")))
        return

    if cmd == "scroll":
        a = sys.argv
        px = int(a[a.index("--px") + 1]) if "--px" in a else 1200
        direction = a[a.index("--dir") + 1] if "--dir" in a else "down"
        sel = a[a.index("--sel") + 1] if "--sel" in a else ""
        wait = int(a[a.index("--wait") + 1]) if "--wait" in a else 900
        r = send({"cmd": "scroll", "px": px, "dir": direction, "sel": sel,
                  "tabId": int(opt("--tab", "0")) or None})
        # scripting.executeScript no espera promesas ni renders de SPA:
        # el scroll es instantaneo, el render sigue en la pagina.
        import time as _t
        _t.sleep(wait / 1000.0)
        if r.get("ok"):
            r["waitedMs"] = wait
        print(json.dumps(r, ensure_ascii=False))
        return

    if cmd == "focus":
        tab_id = args[0] if args else None
        r = send({"cmd": "focus", "tabId": (int(tab_id) if tab_id else None)})
        print(json.dumps(r, ensure_ascii=False))
        return

    if cmd == "reload-ext":
        r = send({"cmd": "reloadExt"})
        print(json.dumps(r, ensure_ascii=False))
        return

    if cmd == "snap-refs":
        # Sin tabId, el snapshot se hacia sobre la pestana ACTIVA y los refs
        # appartenencias a esa: luego fill-ref --tab N decia "ref no encontrado"
        # porque el ref se creo en otra pestana.
        r = send({"cmd": "snapRefs", "tabId": int(opt("--tab", "0")) or None})
        if r.get("ok") and "els" in r:
            limit = 90
            if "--limit" in sys.argv:
                limit = int(sys.argv[sys.argv.index("--limit") + 1])
            only_viewport = "--all" not in sys.argv
            els = r["els"]
            if only_viewport:
                els = [e for e in els if e.get("inViewport")]
            print(f"# {r.get('title')} — {r.get('url')}")
            for e in els[:limit]:
                line = f"  [{e['ref']}] {e.get('role') or e['tag']}"
                if e.get('name'): line += f" \"{e['name'][:80]}\""
                if e.get('type'): line += f" (type={e['type']})"
                print(line)
            if len(els) > limit:
                print(f"  ... ({len(els)-limit} más, sube --limit o quita --all)")
        else:
            print(json.dumps(r, ensure_ascii=False))
        return

    if cmd == "click-ref":
        ref = args[0] if args else input("ref (ej: e3): ")
        r = send({"cmd": "clickRef", "ref": ref, "tabId": int(opt("--tab", "0")) or None})
        print(json.dumps(r, ensure_ascii=False))
        return

    if cmd == "fill-ref":
        if not args:
            print("uso: zen-live fill-ref <ref> <valor> [--submit]"); sys.exit(1)
        ref = args[0]
        # El valor es lo que queda tras el ref, saltando los flags Y su valor.
        # Antes solo se filtraban los flags, asi que "--tab 71" metia "71" dentro
        # del texto escrito en la pagina.
        rest = args[1:]
        skip = set()
        i = 0
        while i < len(rest):
            a = rest[i]
            if a.startswith("--"):
                skip.add(a)
                if a in ("--tab", "--wait", "--nth", "--container", "--cookie-store") and i + 1 < len(rest):
                    skip.add(rest[i + 1]); i += 1
            i += 1
        value = " ".join(a for a in rest if a not in skip)
        submit = "--submit" in sys.argv
        r = send({"cmd": "fillRef", "ref": ref, "value": value, "submit": submit,
                  "tabId": int(opt("--tab", "0")) or None})
        print(json.dumps(r, ensure_ascii=False))
        return

    if cmd == "doctor":
        r = send({"cmd": "doctor"})
        if r.get("ok") and "checks" in r:
            c = r["checks"]
            print(f"version={c.get('version')} manifest={c.get('manifest')} ws={c.get('ws')}")
            perms = c.get("perms", {})
            for k, v in perms.items():
                print(f"  {k}: {'✓' if v else '✗'}")
        else:
            print(json.dumps(r, ensure_ascii=False))
        return

    if cmd == "shot":
        # --tab / --annotated son flags; solo el primer posicionable es el
        # nombre del fichero. Antes "--tab" se colaba como nombre y producia
        # /tmp/zen-shot/--tab.png.
        name = args[0] if args else "captura"
        r = send({"cmd": "shot", "tabId": int(opt("--tab", "0")) or None,
                  "annotated": "annotated" in sys.argv or "annotate" in sys.argv})
        if not r.get("ok"):
            print(json.dumps(r, ensure_ascii=False)); return
        out_dir = "/tmp/zen-shot"
        os.makedirs(out_dir, exist_ok=True)
        path = os.path.join(out_dir, name + ".png")
        with open(path, "wb") as f:
            f.write(base64.b64decode(r["dataUrl"].split(",", 1)[-1]))
        print(path)
        return

    if cmd == "cookies":
        url = args[0] if args else None
        r = send({"cmd": "cookies", "url": url})
        for c in r.get("cookies", []):
            print(f"{c['domain']:30} {c['name']:30} {c['value'][:40]}")
        return

    if cmd == "close":
        if not args:
            print("zen-live close TABID — usa 'zen-live tabs' para ver ids"); return
        r = send({"cmd": "close", "tabId": int(args[0])})
        print(json.dumps(r, ensure_ascii=False))
        return

    # --- v0.11: administracion de los safety guards ---
    if cmd == "guards":
        print(json.dumps(send({"cmd": "guards"}), ensure_ascii=False, indent=2))
        return

    if cmd == "readonly":
        r = _http_control({"op": "readonly", "value": args[0] if args else "status"})
        print(json.dumps(r, ensure_ascii=False, indent=2))
        return

    if cmd == "ratelimit":
        r = _http_control({"op": "ratelimit", "value": args[0] if args else ""})
        print(json.dumps(r, ensure_ascii=False, indent=2))
        return

    if cmd == "audit":
        r = send({"cmd": "audit", "limit": int(opt("--limit", "40"))})
        if not r.get("ok"):
            print(json.dumps(r, ensure_ascii=False)); return
        print("# " + r["file"])
        for e in r["entries"]:
            tgt = " ".join("%s=%s" % (k, v) for k, v in e.get("target", {}).items())
            print("%s %-9s %-15s %-14s %s" % (e["ts"], e["decision"], e.get("guard") or "-", e["cmd"], tgt))
        return

    print(__doc__)


